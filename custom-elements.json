              "name": "#ui",
              "privacy": "private",
              "type": {
                "text": "Ui"
              },
              "default": "Object.fromEntries(Array.from(shadow.querySelectorAll(\"[id]\"), node => [node.id, node])) as unknown"
            },
            {
              "kind": "field",
              "name": "#session",
              "privacy": "private",
              "type": {
                "text": "ScoreSession"
              },
              "default": "new ScoreSession(this, ui, { get type() { return element.type }, get size() { return element.size }, get editing() { return permissions.editing }, updateControls: () => this.#updateControls(), sync: keepSelection => this.#sync(keepSelection), writeScore: (text, keepSelection) => this.#writeScore(text, keepSelection), dataBlock: () => this.#dataBlock(), labelsBlock: () => this.#labelsBlock(), })"
            },
